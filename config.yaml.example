# SBOM Script Configuration
# =========================
# Copy this file to config.yaml and fill in your settings

# GitHub Personal Access Token (Optional)
# - Without token: 60 requests per hour (anonymous)
# - With token: 5000 requests per hour
# 
# To create a token:
# 1. Go to https://github.com/settings/tokens
# 2. Generate new token (classic)
# 3. Select scope: public_repo (for public repositories)
# 4. Copy and paste the token below
GITHUB_TOKEN: ""

# License similarity threshold (0.0 - 1.0)
# If the license content similarity is below this threshold,
# it will be marked as "non-standard"
LICENSE_SIMILARITY_THRESHOLD: 0.9

